{
  "name": "vscode-syntax",
  "private": true,
  "type": "module",
  "description": "Finds HTML/CSS features missing from VS Code's language data, ships them in a local extension, and prepares upstream PRs.",
  "scripts": {
    "setup": "node tools/cli.mjs setup",
    "update": "node tools/cli.mjs update",
    "all": "node tools/cli.mjs all",
    "gap-report": "node tools/cli.mjs warn && node tools/gap-report.mjs ../vscode-custom-data node_modules reports/latest.json && node tools/cli.mjs archive",
    "build-extension": "node tools/cli.mjs warn && node tools/build-extension.mjs",
    "package-extension": "cd extension && npx -y @vscode/vsce@3 package --skip-license --allow-missing-repository --no-rewrite-relative-links",
    "check-vscode": "node tools/check/vscode-live/run.mjs",
    "check-html": "node tools/check/completion-check.mjs ../vscode-html-languageservice extension/data/html.html-data.json",
    "check-css": "node tools/check/css-check.mjs ../vscode-css-languageservice color-interpolation auto,sRGB,linearRGB extension/data/css.css-data.json",
    "apply-html": "node tools/apply-html-additions.mjs",
    "mdn-data-add-property": "node tools/mdn-data/add-property.mjs",
    "additions-from-gap-report": "node tools/additions-from-gap-report.mjs",
    "build-site": "node tools/cli.mjs site"
  },
  "devDependencies": {
    "@mdn/browser-compat-data": "^8.1.5",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/web-custom-data": "^0.6.3",
    "@webref/css": "^8.7.6",
    "@webref/elements": "^2.9.1",
    "browser-specs": "^5.3.0",
    "css-tree": "^3.2.1",
    "mdn-data": "^2.37.2",
    "web-features": "^3.42.0"
  }
}
