              "name": "Specification",
              "url": "https://html.spec.whatwg.org/multipage/iframe-embed-object.html#attr-iframe-loading"
            }
          ]
        },
        {
          "name": "credentialless",
          "level": "draft",
          "valueSet": "v",
          "description": {
            "kind": "markdown",
            "value": "Loads the iframe's document in a new, ephemeral context without the embedder's cookies or storage. Lets cross-origin-isolated pages embed third-party content that doesn't send CORP or COEP headers."
          },
          "browsers": [
            "E110",
            "C110",
            "CA110",
            "O96"
          ],
          "status": {
            "baseline": false
