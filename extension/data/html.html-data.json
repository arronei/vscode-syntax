    {
      "name": "iframe",
      "attributes": [
        {
          "name": "loading",
          "level": "baseline",
          "valueSet": "loading",
          "description": {
            "kind": "markdown",
            "value": "Indicates when the browser should load the iframe. `eager` (the default) loads it immediately; `lazy` defers loading until the iframe nears the viewport."
          },
          "browsers": [
            "E79",
            "FF121",
            "FFA121",
            "S16.4",
            "SM16.4",
            "C77",
            "CA77",
            "O64"
